<tr>
  <td class="align-middle">
    <div class="d-flex align-items-center gap-2">
      <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
           style="width:36px;height:36px;background-color:<%= user.user_type === 'admin' ? '#e63946' : '#1a1a2e' %>;font-family:'Syne',sans-serif;font-size:0.85rem;flex-shrink:0;">
        <%= user.username.charAt(0).toUpperCase() %>
      </div>
      <div>
        <div class="fw-semibold" style="font-family:'Syne',sans-serif;">
          <%= user.username %>
        </div>
        <div class="text-muted" style="font-size:0.8rem;"><%= user.email %></div>
      </div>
    </div>
  </td>
  <td class="align-middle">
    <% if (user.user_type === 'admin') { %>
      <span class="badge rounded-pill px-3 py-2"
            style="background-color:#e63946;font-family:'Syne',sans-serif;font-size:0.75rem;letter-spacing:0.5px;">
        <i class="bi bi-shield-fill me-1"></i>Admin
      </span>
    <% } else { %>
      <span class="badge rounded-pill px-3 py-2 bg-secondary"
            style="font-family:'Syne',sans-serif;font-size:0.75rem;letter-spacing:0.5px;">
        <i class="bi bi-person-fill me-1"></i>User
      </span>
    <% } %>
  </td>
  <td class="align-middle">
    <div class="d-flex gap-2 flex-wrap">
      <form action="/promote" method="POST" class="d-inline">
        <input type="hidden" name="email" value="<%= user.email %>" />
        <button type="submit" class="btn btn-sm btn-brand"
                <%= user.user_type === 'admin' ? 'disabled' : '' %>>
          <i class="bi bi-arrow-up-circle me-1"></i>Promote
        </button>
      </form>
      <form action="/demote" method="POST" class="d-inline">
        <input type="hidden" name="email" value="<%= user.email %>" />
        <button type="submit" class="btn btn-sm btn-outline-danger"
                <%= user.user_type === 'user' ? 'disabled' : '' %>>
          <i class="bi bi-arrow-down-circle me-1"></i>Demote
        </button>
      </form>
    </div>
  </td>
</tr>
