<%- include('templates/header') %>

<section class="py-5">
  <div class="container">
    <% if (loggedIn) { %>
      <!-- Logged-in state -->
      <div class="row justify-content-center">
        <div class="col-lg-7 text-center">
          <div class="mb-4">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white mb-4"
                 style="width:80px;height:80px;background-color:#e63946;font-family:'Syne',sans-serif;font-size:2rem;font-weight:800;">
              <%= user.username.charAt(0).toUpperCase() %>
            </div>
          </div>
          <h1 class="page-title display-5 mb-2">
            Hello, <span style="color:#e63946;"><%= user.username %>!</span>
          </h1>
          <p class="text-muted mb-5" style="font-size:1.1rem;">
            Welcome back. You're signed in as
            <strong><%= user.email %></strong>
            <% if (user.user_type === 'admin') { %>
              &mdash; <span class="badge rounded-pill px-3" style="background-color:#e63946;font-family:'Syne',sans-serif;">Admin</span>
            <% } %>
          </p>

          <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="/members" class="btn btn-brand btn-lg px-5">
              <i class="bi bi-images me-2"></i>Members Area
            </a>
            <% if (user.user_type === 'admin') { %>
              <a href="/admin" class="btn btn-outline-brand btn-lg px-4">
                <i class="bi bi-shield-lock me-2"></i>Admin Panel
              </a>
            <% } %>
            <a href="/logout" class="btn btn-outline-secondary btn-lg px-4">
              <i class="bi bi-box-arrow-right me-2"></i>Sign Out
            </a>
          </div>
        </div>
      </div>

    <% } else { %>
      <!-- Guest state -->
      <div class="row align-items-center g-5 py-4">
        <div class="col-lg-6">
          <p class="text-uppercase fw-bold mb-3" style="color:#e63946;font-family:'Syne',sans-serif;letter-spacing:2px;font-size:0.8rem;">
            COMP 2537 &mdash; Assignment 2
          </p>
          <div class="d-flex gap-3 flex-wrap">
            <a href="/signup" class="btn btn-brand btn-lg px-5">
              <i class="bi bi-person-plus me-2"></i>Sign Up
            </a>
            <a href="/login" class="btn btn-outline-brand btn-lg px-4">
              <i class="bi bi-box-arrow-in-right me-2"></i>Log In
            </a>
          </div>
        </div>
      </div>
    <% } %>

  </div>
</section>

<%- include('templates/footer') %>
